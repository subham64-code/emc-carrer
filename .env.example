# ============================================================
# EMC Talent Acquisition Portal - Environment Configuration
# Copy this file to .env and replace every placeholder value.
# NEVER commit real secrets.
# ============================================================

# ----- Runtime -----
NODE_ENV=development
PORT=4000
APP_NAME="EMC Talent Acquisition Portal"
APP_URL=http://localhost:5173
# Public EMC corporate careers site (job listings + candidate apply form)
CAREER_SITE_URL=http://localhost:5000/careers.html
TRACK_APPLICATION_URL=http://localhost:5000/track-application.html
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4000,http://localhost:5000,http://127.0.0.1:5000
DEFAULT_TIMEZONE=Asia/Kolkata

# ----- Database (Neon PostgreSQL - cloud) -----
# Production / cloud database. The `schema` parameter isolates the EMC Talent
# Acquisition tables inside the shared Neon database.
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&schema=emc_talent"
DATABASE_URL="postgresql://neondb_owner:REPLACE@ep-frosty-river-bdzur7d7-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&schema=emc_talent"
# Transport: auto (probe tcp -> ws -> http at startup), tcp, ws or http.
# auto keeps the backend working on any network; set explicitly to skip probing.
DB_TRANSPORT=auto

# ----- Authentication -----
JWT_SECRET=replace-with-a-64-character-random-string
JWT_EXPIRES_IN=12h
# TOTP (HR roles): base64-encoded 32-byte AES-256-GCM key for encrypting secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=replace-with-a-base64-32-byte-random-key
TOTP_ISSUER=Ecometrix
TOTP_WINDOW_SECONDS=30
TOTP_ENROLLMENT_TTL_MINUTES=10
TOTP_MAX_ATTEMPTS=5
TOTP_LOCKOUT_MINUTES=15
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMPLOYEE_INVITE_TTL_HOURS=72
SESSION_TTL_HOURS=12

# ----- Initial super admin (used by seed only) -----
SEED_SUPER_ADMIN_EMAIL=hr.admin@emc.example
SEED_SUPER_ADMIN_NAME="HR Department"
# IT administrator: can sign in with OTP and password, and can reset HR accounts
SEED_IT_ADMIN_EMAIL=it.admin@emc.example
SEED_IT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ----- File storage (S3 compatible bucket) -----
STORAGE_PROVIDER=s3
STORAGE_ALLOW_LOCAL=false
LOCAL_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=10
# Publicly reachable API base used to build links in emails
PUBLIC_API_URL=https://your-api-domain.com

# ----- Cloud bucket credentials (Filebase / AWS S3 / R2 / Spaces) -----
S3_ENDPOINT=https://s3.filebase.io
S3_REGION=auto
S3_BUCKET=hr-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ----- SMTP / Nodemailer (Brevo recommended) -----
# When SMTP is not configured emails are simulated and logged.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Keep TLS certificate verification enabled (set false only for a trusted dev relay)
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EMC Talent Acquisition <verified-sender@yourdomain.com>"
MAIL_REPLY_TO=hr@emc.example

# Resend (optional fallback when set)
RESEND_API_KEY=

# ----- AI / OCR -----
# Weights are percentages and must add up to 100.
AI_WEIGHT_SKILLS=35
AI_WEIGHT_EXPERIENCE=25
AI_WEIGHT_QUALIFICATION=15
AI_WEIGHT_DOMAIN=15
AI_WEIGHT_CERTIFICATION=10
OCR_ENABLED=true
OCR_LANGUAGES=eng
AI_TOP_RECOMMENDATIONS=10
# v1 = existing five-dimension scorer, v2 = six-dimension explainable scorer
AI_SCORING_VERSION=v1

# ----- Rate limiting + caching -----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# In-process cache for hot-path reads (dashboard, career listings, reports)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
# Short-TTL cache for resolved auth sessions (cuts 1-2 Neon round trips per API call)
AUTH_CACHE_ENABLED=true
AUTH_CACHE_TTL_SECONDS=30

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=/api/v1
VITE_CAREER_SITE_URL=http://localhost:5000/careers.html
VITE_APP_NAME="EMC Talent Acquisition Portal"
VITE_SUPPORT_EMAIL=hr@emc.example

# Resend (preferred when set)
RESEND_API_KEY=
